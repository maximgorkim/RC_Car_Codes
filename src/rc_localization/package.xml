<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rc_localization</name>
  <version>0.1.0</version>
  <description>Low-latency localization for the RC car: VESC + IMU twist, delayed LiDAR pose, EKF with delay compensation (Foxy and Humble).</description>
  <maintainer email="keskinmehmetgorkem@gmail.com">gorkem</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>vesc_msgs</depend>
  <depend>eigen</depend>

  <exec_depend>rclpy</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
